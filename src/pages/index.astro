---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Gaza Stack">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <h1 class="text-3xl font-bold tracking-tight mb-3">Gaza Stack</h1>
      <p class="text-zinc-400 mb-8">Self-hosted deployment platform.<br>Preview deployments, sessions, and CI/CD &mdash; on your own VPS.</p>
      <a href="/setup/1"
        class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-sm font-medium rounded-lg transition-colors">
        Get Started &rarr;
      </a>
      <p class="text-xs text-zinc-600 mt-4">~10 minutes &middot; ~$12</p>
    </div>
  </main>
</Layout>
