---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={2} title="Connect Cloudflare" subtitle="Register a domain on Cloudflare or use one you already own, then create an API token.">
  <div class="space-y-6">
    <!-- Domain -->
    <div>
      <label for="domain" class="block text-sm font-medium mb-1.5">Domain name</label>
      <input id="domain" type="text" placeholder="mysite.com"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600" />
      <p class="text-xs text-zinc-500 mt-1.5">Any format works &mdash; we'll extract the domain automatically</p>
      <div class="mt-2 bg-amber-950/30 border border-amber-900/50 rounded-lg px-3 py-2">
        <p class="text-xs text-amber-400/90">Use a domain for dev environments (e.g. <code class="text-amber-300">myteam.dev</code>) &mdash; sessions will run on subdomains like <code class="text-amber-300">feature-x.myteam.dev</code></p>
      </div>
    </div>

    <!-- API Token -->
    <div>
      <label for="cf-token" class="block text-sm font-medium mb-1.5">Cloudflare API Token</label>
      <input id="cf-token" type="text" autocomplete="off" placeholder="Paste your Cloudflare API token"
        class="secret-input w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
      <p class="text-xs text-zinc-500 mt-1.5">Needs <code class="text-zinc-400">Zone:Zone:Read</code> and <code class="text-zinc-400">Zone:DNS:Edit</code> permissions</p>
    </div>

    <!-- Instructions with screenshot -->
    <details class="group">
      <summary class="text-sm text-zinc-400 hover:text-zinc-300 cursor-pointer transition-colors">
        How to create the API token &darr;
      </summary>
      <div class="mt-3 space-y-3">
        <ol class="text-xs text-zinc-400 space-y-2 list-decimal list-inside">
          <li>Open the <a href="https://dash.cloudflare.com/" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">Cloudflare dashboard</a></li>
          <li>Select your account, then go to <strong class="text-zinc-300">Manage Account &rarr; API Tokens</strong></li>
          <li>Click <strong class="text-zinc-300">Create Token</strong></li>
          <li>Select <strong class="text-zinc-300">Create Custom Token</strong></li>
          <li>Set permissions exactly as shown below</li>
          <li>Under Zone Resources, select your specific domain</li>
          <li>Click <strong class="text-zinc-300">Continue to summary</strong>, then <strong class="text-zinc-300">Create Token</strong></li>
        </ol>
        <div class="border border-zinc-800 rounded-lg overflow-hidden">
          <img src="/cf-token-setup.png" alt="Cloudflare token setup: Zone:Zone:Read and Zone:DNS:Edit permissions, specific zone selected"
            class="w-full" loading="lazy" />
        </div>
      </div>
    </details>
  </div>
</SetupLayout>

<script is:inline>
(function() {
  var domain = document.getElementById('domain');
  var cfToken = document.getElementById('cf-token');
  var btn = document.getElementById('next-btn');

  domain.value = GS.val('domain');
  cfToken.value = GS.val('cloudflareToken');

  function clean(s) {
    s = s.trim().toLowerCase();
    if (!s) return '';
    try {
      return new URL(s.indexOf('://') === -1 ? 'https://' + s : s).hostname;
    } catch(e) {
      return s.replace(/^https?:\/\//, '').replace(/[\/\?#:].*/g, '');
    }
  }

  function isDomain(s) {
    return /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z]{2,})+$/.test(s);
  }

  function validate() {
    var d = clean(domain.value);
    var t = cfToken.value.trim();
    btn.disabled = !(isDomain(d) && t.length > 10);
  }

  domain.addEventListener('input', validate);
  cfToken.addEventListener('input', validate);
  validate();

  btn.addEventListener('click', function() {
    GS.set({
      domain: clean(domain.value),
      cloudflareToken: cfToken.value.trim(),
    });
    window.location.href = btn.dataset.href;
  });
})();
</script>
