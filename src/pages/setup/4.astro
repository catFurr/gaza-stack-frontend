---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={4} title="Connect GitHub" subtitle="Create a Personal Access Token so we can manage repos and workflows.">
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 mb-6">
    <p class="text-sm font-medium mb-2">Required token permissions:</p>
    <ul class="text-sm text-zinc-400 space-y-1">
      <li>&bull; <code class="text-zinc-300">repo</code> &mdash; full access</li>
      <li>&bull; <code class="text-zinc-300">workflow</code> &mdash; update workflows</li>
      <li>&bull; <code class="text-zinc-300">admin:repo_hook</code> &mdash; manage hooks</li>
    </ul>
  </div>

  <a href="https://github.com/settings/tokens/new?scopes=repo,workflow,admin:repo_hook&description=Gaza+Stack+Setup" target="_blank" rel="noopener"
    class="inline-flex items-center gap-2 px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors mb-6">
    Create token on GitHub <span class="text-zinc-500">&nearr;</span>
  </a>

  <div>
    <label for="pat" class="block text-sm font-medium mb-1.5">Personal Access Token</label>
    <input id="pat" type="password" placeholder="ghp_..."
      class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
  </div>

  <button id="verify-btn"
    class="mt-4 px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors">
    Verify
  </button>

  <div id="gh-result" class="mt-4 hidden"></div>
  <div id="scope-result" class="mt-2 hidden"></div>
</SetupLayout>

<script is:inline>
(function() {
  var pat = document.getElementById('pat');
  var btn = document.getElementById('next-btn');
  var verifyBtn = document.getElementById('verify-btn');
  var result = document.getElementById('gh-result');
  var scopeResult = document.getElementById('scope-result');

  pat.value = GS.val('githubPat');

  var requiredScopes = ['repo', 'workflow', 'admin:repo_hook'];

  function showScopeStatus(scopes) {
    scopeResult.classList.remove('hidden');
    var scopeList = scopes.split(',').map(function(s) { return s.trim(); });
    var html = '<div class="space-y-1">';
    var allOk = true;

    requiredScopes.forEach(function(req) {
      var has = scopeList.some(function(s) { return s === req; });
      if (has) {
        html += '<div class="flex items-center gap-2 text-xs"><span class="text-emerald-400">&#10003;</span> <code>' + req + '</code></div>';
      } else {
        html += '<div class="flex items-center gap-2 text-xs"><span class="text-red-400">&#10007;</span> <code>' + req + '</code> <span class="text-zinc-500">&mdash; missing, create a new token with this scope</span></div>';
        allOk = false;
      }
    });

    html += '</div>';
    scopeResult.innerHTML = html;
    return allOk;
  }

  // If already verified, show it
  if (GS.val('githubUser')) {
    result.classList.remove('hidden');
    result.innerHTML = '<div class="flex items-center gap-2 text-sm"><span class="text-emerald-400">&#10003;</span> Connected as <strong>@' + GS.val('githubUser') + '</strong></div>';
    btn.disabled = false;
  }

  verifyBtn.addEventListener('click', function() {
    var token = pat.value.trim();
    if (!token) return;

    verifyBtn.disabled = true;
    verifyBtn.textContent = 'Verifying...';
    result.classList.remove('hidden');
    scopeResult.classList.add('hidden');

    fetch('https://api.github.com/user', {
      headers: { Authorization: 'token ' + token }
    })
    .then(function(r) {
      if (!r.ok) throw new Error('Invalid token');
      var scopes = r.headers.get('X-OAuth-Scopes') || '';
      return r.json().then(function(user) { return { user: user, scopes: scopes }; });
    })
    .then(function(data) {
      result.innerHTML = '<div class="flex items-center gap-2 text-sm"><span class="text-emerald-400">&#10003;</span> Connected as <strong>@' + data.user.login + '</strong></div>';
      GS.set({ githubPat: token, githubUser: data.user.login });

      var scopesOk = showScopeStatus(data.scopes);
      btn.disabled = !scopesOk;
    })
    .catch(function(e) {
      result.innerHTML = '<div class="flex items-center gap-2 text-sm text-red-400"><span>&#10007;</span> ' + e.message + '. Check your token and try again.</div>';
      scopeResult.classList.add('hidden');
      btn.disabled = true;
    })
    .finally(function() {
      verifyBtn.disabled = false;
      verifyBtn.textContent = 'Verify';
    });
  });

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });
})();
</script>
