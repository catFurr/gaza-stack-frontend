---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={6} title="SSH config" subtitle="Your SSH config was set up in step 1. Here's a quick reference.">
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm font-medium">~/.ssh/config</span>
      <button id="copy-btn" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Copy</button>
    </div>
    <pre id="ssh-config" class="text-sm font-mono text-zinc-300 overflow-x-auto whitespace-pre"></pre>
  </div>

  <p class="text-sm text-zinc-400 mt-4">Test with: <code class="text-zinc-300">ssh <span id="ssh-alias"></span></code></p>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var domain = state.domain || 'mysite.com';
  var ipv4 = state.ipv4 || '0.0.0.0';
  var keyPath = state.sshKeyPath || '~/.ssh/id_ed25519';
  var alias = domain.split('.')[0];
  var btn = document.getElementById('next-btn');

  var config = 'Host ' + alias + '\n  HostName ' + ipv4 + '\n  User root\n  IdentityFile ' + keyPath;
  document.getElementById('ssh-config').textContent = config;
  document.getElementById('ssh-alias').textContent = alias;

  document.getElementById('copy-btn').addEventListener('click', function() {
    navigator.clipboard.writeText(config);
    this.textContent = 'Copied!';
    var self = this;
    setTimeout(function() { self.textContent = 'Copy'; }, 1500);
  });

  // Auto-enable continue since this is just a reference
  btn.disabled = false;

  btn.addEventListener('click', function() {
    GS.set({ sshAlias: alias });
    window.location.href = btn.dataset.href;
  });
})();
</script>
