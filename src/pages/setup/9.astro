---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={9} title="Add workflows" subtitle="We'll create a pull request with the GitHub Actions workflows your repo needs.">
  <div class="space-y-6">
    <!-- Deploy workflow -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-medium">.github/workflows/deploy.yml</span>
        <button id="copy-deploy" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Copy</button>
      </div>
      <pre id="deploy-yaml" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre max-h-64 overflow-y-auto"></pre>
    </div>

    <!-- Provision workflow -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-medium">.github/workflows/provision.yml</span>
        <button id="copy-provision" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Copy</button>
      </div>
      <pre id="provision-yaml" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 text-xs font-mono text-zinc-300 overflow-x-auto whitespace-pre max-h-64 overflow-y-auto"></pre>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <button id="create-pr-btn"
      class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-sm font-medium rounded-lg transition-colors">
      Create pull request
    </button>
    <button id="check-workflows-btn"
      class="px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors">
      Check workflows
    </button>
  </div>

  <div id="pr-msg" class="mt-4 hidden"></div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var repo = state.repoFullName || '';
  var repoName = repo.split('/')[1] || '';
  var domain = state.domain || 'example.com';
  var buildCommand = state.buildCommand || 'bun run build';
  var outputDir = state.outputDir || 'dist';
  var branch = state.defaultBranch || 'main';
  var token = state.githubPat || '';
  var btn = document.getElementById('next-btn');

  // Detect package manager from build command
  var pm = 'npm';
  if (buildCommand.indexOf('bun') === 0) pm = 'bun';
  else if (buildCommand.indexOf('pnpm') === 0) pm = 'pnpm';
  else if (buildCommand.indexOf('yarn') === 0) pm = 'yarn';

  var setupStep, installCmd;
  switch (pm) {
    case 'bun':
      setupStep = '      - uses: oven-sh/setup-bun@v2';
      installCmd = 'bun install';
      break;
    case 'pnpm':
      setupStep = '      - uses: pnpm/action-setup@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: pnpm';
      installCmd = 'pnpm install --frozen-lockfile';
      break;
    case 'yarn':
      setupStep = '      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: yarn';
      installCmd = 'yarn install --frozen-lockfile';
      break;
    default:
      setupStep = '      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm';
      installCmd = 'npm ci';
  }

  var hasAnthropic = !!state.anthropicApiKey;
  var hasOpenai = !!state.openaiApiKey;

  var ghPrSha = '$' + '{{ github.event.pull_request.head.sha || github.sha }}';
  var ghHead = '$' + '{{ github.event.pull_request.head.ref }}';
  var sVPS_SSH = '$' + '{{ secrets.VPS_SSH_KEY }}';
  var sVPS_HOST = '$' + '{{ secrets.VPS_HOST }}';
  var sCF_TOKEN = '$' + '{{ secrets.CLOUDFLARE_API_TOKEN }}';
  var sKON_GH = '$' + '{{ secrets.KON_GITHUB_TOKEN }}';
  var sANTHROPIC = '$' + '{{ secrets.ANTHROPIC_API_KEY }}';
  var sOPENAI = '$' + '{{ secrets.OPENAI_API_KEY }}';
  var ghActor = '$' + '{{ github.actor }}';
  var envExpr = "$" + "{{ github.ref == 'refs/heads/" + branch + "' && 'production' || 'preview' }}";

  // KON_REPOS embedded directly in the workflow
  var konReposVal = JSON.stringify([{ name: repoName, url: 'https://github.com/' + repo }]);

  var deployYaml = [
    'name: Build & Deploy',
    'on:',
    '  push:',
    '    branches: [' + branch + ']',
    '  pull_request:',
    '  workflow_dispatch:',
    '',
    'jobs:',
    '  build:',
    '    runs-on: ubuntu-latest',
    '    steps:',
    '      - uses: actions/checkout@v4',
    setupStep,
    '      - run: ' + installCmd,
    '      - run: ' + buildCommand,
    '      - uses: actions/upload-artifact@v4',
    '        with:',
    '          name: build',
    '          path: ' + outputDir + '/',
    '',
    '  deploy:',
    '    needs: build',
    '    permissions:',
    '      pull-requests: write',
    '    uses: catFurr/kon/.github/workflows/deploy.yml@main',
    '    with:',
    '      domain: ' + domain,
    '      artifact_name: build',
    '      environment: ' + envExpr,
    '      branch_slug: ' + ghHead,
    '      sha: ' + ghPrSha,
    '    secrets:',
    '      VPS_SSH_KEY: ' + sVPS_SSH,
    '      VPS_HOST: ' + sVPS_HOST,
  ].join('\n');

  var provisionYaml = [
    'name: Provision Server',
    'on:',
    '  workflow_dispatch:',
    '    inputs:',
    '      domain:',
    '        required: true',
    '        type: string',
    '        default: ' + domain,
    '',
    'jobs:',
    '  provision:',
    '    runs-on: ubuntu-latest',
    '    steps:',
    '      - uses: actions/checkout@v4',
    '        with:',
    '          repository: catFurr/kon',
    '          ref: main',
    '',
    '      - name: Setup SSH',
    '        run: |',
    '          mkdir -p ~/.ssh',
    '          echo "' + sVPS_SSH + '" > ~/.ssh/deploy_key',
    '          chmod 600 ~/.ssh/deploy_key',
    '          ssh-keyscan -H ' + sVPS_HOST + ' >> ~/.ssh/known_hosts',
    '',
    '      - name: Install Ansible',
    '        run: pip install ansible',
    '',
    '      - name: Write inventory',
    '        run: |',
    '          cat > ansible/inventory/hosts.yml << EOF',
    '          all:',
    '            hosts:',
    '              vps:',
    '                ansible_host: ' + sVPS_HOST,
    '                ansible_user: root',
    '                ansible_ssh_private_key_file: ~/.ssh/deploy_key',
    '          EOF',
    '',
    '      - name: Provision',
    '        working-directory: ansible',
    '        run: |',
    '          ansible-playbook playbooks/provision.yml \\',
    "            -e \"domain=" + '$' + "{{ inputs.domain }}\" \\",
    '            -e "cloudflare_api_token=' + sCF_TOKEN + '" \\',
    "            -e '" + '{"repos": ' + konReposVal + "}' \\",
    '            -e "github_token=' + sKON_GH + '" \\',
    '            -e "github_user=' + ghActor + '"' +
    (hasAnthropic ? ' \\\n            -e "anthropic_api_key=' + sANTHROPIC + '"' : '') +
    (hasOpenai ? ' \\\n            -e "openai_api_key=' + sOPENAI + '"' : ''),
    '        env:',
    '          ANSIBLE_HOST_KEY_CHECKING: "false"',
  ].join('\n');

  document.getElementById('deploy-yaml').textContent = deployYaml;
  document.getElementById('provision-yaml').textContent = provisionYaml;

  // Copy buttons
  document.getElementById('copy-deploy').addEventListener('click', function() {
    navigator.clipboard.writeText(deployYaml);
    this.textContent = 'Copied!';
    var self = this;
    setTimeout(function() { self.textContent = 'Copy'; }, 1500);
  });

  document.getElementById('copy-provision').addEventListener('click', function() {
    navigator.clipboard.writeText(provisionYaml);
    this.textContent = 'Copied!';
    var self = this;
    setTimeout(function() { self.textContent = 'Copy'; }, 1500);
  });

  var prBtn = document.getElementById('create-pr-btn');
  var checkBtn = document.getElementById('check-workflows-btn');
  var msgEl = document.getElementById('pr-msg');

  function ghApi(method, path, body) {
    var opts = {
      method: method,
      headers: { Authorization: 'token ' + token, 'Content-Type': 'application/json' },
    };
    if (body) opts.body = JSON.stringify(body);
    return fetch('https://api.github.com' + path, opts);
  }

  // Create PR with workflow files
  prBtn.addEventListener('click', async function() {
    if (!token || !repo) return;

    prBtn.disabled = true;
    prBtn.textContent = 'Creating PR...';
    msgEl.classList.add('hidden');

    try {
      // 1. Get the SHA of the default branch
      var refRes = await ghApi('GET', '/repos/' + repo + '/git/ref/heads/' + branch);
      if (!refRes.ok) throw new Error('Cannot read default branch');
      var refData = await refRes.json();
      var baseSha = refData.object.sha;

      // 2. Create a new branch
      var prBranch = 'gaza-stack-setup';
      // Delete existing branch if present (ignore errors)
      await ghApi('DELETE', '/repos/' + repo + '/git/refs/heads/' + prBranch).catch(function() {});

      var branchRes = await ghApi('POST', '/repos/' + repo + '/git/refs', {
        ref: 'refs/heads/' + prBranch,
        sha: baseSha,
      });
      if (!branchRes.ok) throw new Error('Failed to create branch');

      // 3. Create/update workflow files on the new branch
      async function createOrUpdateFile(path, content) {
        // Check if file exists
        var existRes = await ghApi('GET', '/repos/' + repo + '/contents/' + path + '?ref=' + prBranch);
        var body = {
          message: 'Add ' + path.split('/').pop(),
          content: btoa(unescape(encodeURIComponent(content))),
          branch: prBranch,
        };
        if (existRes.ok) {
          var existData = await existRes.json();
          body.sha = existData.sha;
        }
        var putRes = await ghApi('PUT', '/repos/' + repo + '/contents/' + path, body);
        if (!putRes.ok) throw new Error('Failed to create ' + path);
      }

      await createOrUpdateFile('.github/workflows/deploy.yml', deployYaml);
      await createOrUpdateFile('.github/workflows/provision.yml', provisionYaml);

      // 4. Create PR
      var prRes = await ghApi('POST', '/repos/' + repo + '/pulls', {
        title: 'Add Gaza Stack deployment workflows',
        head: prBranch,
        base: branch,
        body: '## Gaza Stack Setup\n\nAdds GitHub Actions workflows for:\n- **Build & Deploy** — builds on push/PR, deploys via kon\n- **Provision Server** — sets up the VPS with nginx, SSL, and dev tools\n\nGenerated by [Gaza Stack](https://github.com/catFurr/kon) setup wizard.',
      });

      if (!prRes.ok) {
        var prErr = await prRes.json();
        throw new Error(prErr.message || 'Failed to create PR');
      }

      var prData = await prRes.json();
      GS.set({ workflowPrUrl: prData.html_url, workflowPrNumber: prData.number });

      msgEl.classList.remove('hidden');
      msgEl.innerHTML = '<div class="text-sm"><span class="text-emerald-400">&#10003;</span> Pull request created: <a href="' + prData.html_url + '" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">#' + prData.number + '</a></div>' +
        '<p class="text-xs text-zinc-500 mt-1">Merge the PR, then continue to the next step.</p>';
      btn.disabled = false;

    } catch (e) {
      msgEl.classList.remove('hidden');
      msgEl.innerHTML = '<p class="text-sm text-red-400">Error: ' + e.message + '</p>';
    } finally {
      prBtn.disabled = false;
      prBtn.textContent = 'Create pull request';
    }
  });

  // Check if workflows exist in repo (after PR merge)
  checkBtn.addEventListener('click', async function() {
    checkBtn.disabled = true;
    checkBtn.textContent = 'Checking...';
    msgEl.classList.add('hidden');

    try {
      var deployRes = await ghApi('GET', '/repos/' + repo + '/contents/.github/workflows/deploy.yml?ref=' + branch);
      var provisionRes = await ghApi('GET', '/repos/' + repo + '/contents/.github/workflows/provision.yml?ref=' + branch);

      var deployOk = deployRes.ok;
      var provisionOk = provisionRes.ok;

      msgEl.classList.remove('hidden');
      var html = '<div class="space-y-1">';
      html += '<div class="flex items-center gap-2 text-sm">' +
        (deployOk ? '<span class="text-emerald-400">&#10003;</span>' : '<span class="text-red-400">&#10007;</span>') +
        ' deploy.yml</div>';
      html += '<div class="flex items-center gap-2 text-sm">' +
        (provisionOk ? '<span class="text-emerald-400">&#10003;</span>' : '<span class="text-red-400">&#10007;</span>') +
        ' provision.yml</div>';
      html += '</div>';

      if (!deployOk || !provisionOk) {
        html += '<p class="text-xs text-zinc-500 mt-2">Merge the pull request first, then check again.</p>';
      }

      msgEl.innerHTML = html;
      btn.disabled = !(deployOk && provisionOk);

    } catch (e) {
      msgEl.classList.remove('hidden');
      msgEl.innerHTML = '<p class="text-sm text-red-400">Error: ' + e.message + '</p>';
    } finally {
      checkBtn.disabled = false;
      checkBtn.textContent = 'Check workflows';
    }
  });

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });
})();
</script>
