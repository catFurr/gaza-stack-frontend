---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={9} title="Verify provision workflow" subtitle="Confirm that the provision workflow is ready in your kon fork.">
  <div class="space-y-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium">Workflow status</span>
        <span id="workflow-status" class="text-xs text-zinc-600">checking...</span>
      </div>
      <p id="workflow-detail" class="text-xs text-zinc-500"></p>
    </div>

    <div class="flex items-center gap-3">
      <button id="check-btn"
        class="px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors">
        Re-check
      </button>
      <a id="repo-link" href="#" target="_blank" rel="noopener"
        class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">
        View fork on GitHub &nearr;
      </a>
    </div>
  </div>

  <div class="mt-6">
    <h3 class="text-sm font-medium mb-2">What happens next</h3>
    <ul class="text-xs text-zinc-500 space-y-1.5">
      <li>&bull; The provision workflow will set up your VPS with nginx, SSL, Docker, and dev tools</li>
      <li>&bull; Your project repos will be configured for cloning into dev sessions</li>
      <li>&bull; AI coding tools (Claude Code, Codex) will be installed if keys were provided</li>
    </ul>
  </div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var konFork = state.konForkFullName || '';
  var token = state.githubPat || '';
  var btn = document.getElementById('next-btn');
  var statusEl = document.getElementById('workflow-status');
  var detailEl = document.getElementById('workflow-detail');
  var checkBtn = document.getElementById('check-btn');
  var repoLink = document.getElementById('repo-link');

  if (konFork) {
    repoLink.href = 'https://github.com/' + konFork;
  }

  function checkWorkflow() {
    if (!konFork || !token) {
      statusEl.textContent = 'missing';
      statusEl.className = 'text-xs text-red-400';
      detailEl.textContent = 'No kon fork configured. Go back to step 8.';
      return;
    }

    statusEl.textContent = 'checking...';
    statusEl.className = 'text-xs text-zinc-600';

    fetch('https://api.github.com/repos/' + konFork + '/contents/.github/workflows/provision.yml', {
      headers: { Authorization: 'token ' + token }
    })
    .then(function(r) {
      if (r.ok) {
        statusEl.textContent = '✓ found';
        statusEl.className = 'text-xs text-emerald-400';
        detailEl.innerHTML = '<code class="text-zinc-300">.github/workflows/provision.yml</code> exists in <a href="https://github.com/' + konFork + '" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">' + konFork + '</a>';
        btn.disabled = false;
      } else {
        statusEl.textContent = '✗ not found';
        statusEl.className = 'text-xs text-red-400';
        detailEl.textContent = 'Workflow not found in ' + konFork + '. Make sure the fork is up to date with catFurr/kon.';
      }
    })
    .catch(function(e) {
      statusEl.textContent = 'error';
      statusEl.className = 'text-xs text-red-400';
      detailEl.textContent = 'Error: ' + e.message;
    });
  }

  checkBtn.addEventListener('click', checkWorkflow);

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });

  checkWorkflow();
})();
</script>
