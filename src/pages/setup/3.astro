---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={3} title="Configure DNS" subtitle="Add these records in your Cloudflare DNS dashboard. Proxy must be off (DNS only).">
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden mb-6">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-zinc-500 text-xs border-b border-zinc-800">
          <th class="text-left px-4 py-2 font-medium">Type</th>
          <th class="text-left px-4 py-2 font-medium">Name</th>
          <th class="text-left px-4 py-2 font-medium">Content</th>
          <th class="text-left px-4 py-2 font-medium w-20">Status</th>
        </tr>
      </thead>
      <tbody id="dns-table" class="font-mono"></tbody>
    </table>
  </div>

  <a id="dns-link" href="#" target="_blank" rel="noopener"
    class="inline-flex items-center gap-2 px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors mb-4">
    Open Cloudflare DNS <span class="text-zinc-500">&nearr;</span>
  </a>

  <div class="flex items-center gap-3">
    <button id="check-dns-btn"
      class="px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm hover:border-zinc-700 transition-colors">
      Check DNS
    </button>
    <span id="check-status" class="text-xs text-zinc-600"></span>
  </div>

  <div id="dns-msg" class="mt-4 hidden"></div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var domain = state.domain || 'example.com';
  var ipv4 = state.ipv4 || '0.0.0.0';
  var ipv6 = state.ipv6 || '';
  var btn = document.getElementById('next-btn');

  document.getElementById('dns-link').href = 'https://dash.cloudflare.com/?search=' + domain;

  var records = [
    { type: 'A', name: domain,          content: ipv4 },
    { type: 'A', name: '*.' + domain,   content: ipv4 },
  ];
  if (ipv6) {
    records.push({ type: 'AAAA', name: domain,        content: ipv6 });
    records.push({ type: 'AAAA', name: '*.' + domain,  content: ipv6 });
  }

  var table = document.getElementById('dns-table');
  records.forEach(function(r, i) {
    var tr = document.createElement('tr');
    tr.className = 'border-b border-zinc-800/50';
    tr.innerHTML =
      '<td class="px-4 py-2.5 text-emerald-400">' + r.type + '</td>' +
      '<td class="px-4 py-2.5">' + r.name + '</td>' +
      '<td class="px-4 py-2.5 text-zinc-400">' + r.content + '</td>' +
      '<td class="px-4 py-2.5"><span id="rec-status-' + i + '" class="text-xs text-zinc-600">&mdash;</span></td>';
    table.appendChild(tr);
  });

  var checkBtn = document.getElementById('check-dns-btn');
  var checkStatus = document.getElementById('check-status');
  var msgEl = document.getElementById('dns-msg');

  function dnsLookup(name, type) {
    return fetch('https://cloudflare-dns.com/dns-query?name=' + encodeURIComponent(name) + '&type=' + type, {
      headers: { Accept: 'application/dns-json' }
    })
    .then(function(r) { return r.json(); })
    .then(function(d) { return (d.Answer || []).map(function(a) { return a.data.replace(/\.$/,''); }); })
    .catch(function() { return []; });
  }

  function setRecStatus(i, ok, text) {
    var el = document.getElementById('rec-status-' + i);
    el.textContent = text;
    el.className = 'text-xs ' + (ok ? 'text-emerald-400' : 'text-amber-400');
  }

  function checkDNS() {
    checkBtn.disabled = true;
    checkBtn.textContent = 'Checking...';
    checkStatus.textContent = '';
    msgEl.classList.add('hidden');

    var wildcardTest = '_gs-' + Date.now() + '.' + domain;
    var checks = [
      { type: 'A', name: domain,        expect: ipv4, idx: 0 },
      { type: 'A', name: wildcardTest,   expect: ipv4, idx: 1 },
    ];
    if (ipv6) {
      checks.push({ type: 'AAAA', name: domain,       expect: ipv6, idx: 2 });
      checks.push({ type: 'AAAA', name: wildcardTest,  expect: ipv6, idx: 3 });
    }

    var allGood = true;
    Promise.all(checks.map(function(c) {
      return dnsLookup(c.name, c.type).then(function(found) {
        var ok = found.includes(c.expect);
        if (!ok) allGood = false;
        if (ok) {
          setRecStatus(c.idx, true, '\u2713 live');
        } else if (found.length > 0) {
          setRecStatus(c.idx, false, '\u2717 points to ' + found[0]);
        } else {
          setRecStatus(c.idx, false, '\u2717 not found');
        }
      });
    }))
    .then(function() {
      msgEl.classList.remove('hidden');
      if (allGood) {
        btn.disabled = false;
        msgEl.innerHTML = '<p class="text-sm text-emerald-400">\u2713 DNS is configured and propagated.</p>';
      } else {
        msgEl.innerHTML =
          '<div class="bg-amber-950/30 border border-amber-900/50 rounded-lg p-4 space-y-2">' +
            '<p class="text-sm text-amber-400 font-medium">\u26a0 Some DNS records are not resolving</p>' +
            '<ul class="text-xs text-zinc-400 space-y-1.5 mt-2">' +
              '<li>&bull; Make sure proxy is <strong class="text-zinc-300">off</strong> (grey cloud icon, DNS only) in Cloudflare</li>' +
              '<li>&bull; Check that record values match the table above exactly</li>' +
              '<li>&bull; DNS propagation can take a few minutes &mdash; try again shortly</li>' +
            '</ul>' +
          '</div>';
      }
    })
    .finally(function() {
      checkBtn.disabled = false;
      checkBtn.textContent = 'Check DNS';
    });
  }

  checkBtn.addEventListener('click', checkDNS);

  // Auto-check on page load
  checkDNS();

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });
})();
</script>
