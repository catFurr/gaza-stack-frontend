---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={8} title="Set up infrastructure repo" subtitle="Fork the kon repo, save your config, and set secrets.">
  <script is:inline src="https://cdn.jsdelivr.net/npm/libsodium-wrappers@0.7.15/dist/modules/libsodium-wrappers.min.js"></script>

  <!-- Step 1: Fork kon -->
  <div id="fork-section" class="space-y-3">
    <p class="text-sm text-zinc-400">Your infrastructure will be managed through a fork of <a href="https://github.com/catFurr/kon" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">catFurr/kon</a>.</p>

    <div id="fork-status" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium">Fork status</span>
        <span id="fork-status-badge" class="text-xs text-zinc-600">checking...</span>
      </div>
      <p id="fork-status-detail" class="text-xs text-zinc-500 mt-1"></p>
    </div>

    <button id="fork-btn" type="button"
      class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-800 disabled:text-zinc-600 disabled:cursor-not-allowed text-sm font-medium rounded-lg transition-colors hidden">
      Fork catFurr/kon
    </button>
  </div>

  <!-- Step 2: Config + Secrets (shown after fork) -->
  <div id="config-section" class="mt-6 hidden">
    <!-- stack.json commit -->
    <div class="mb-6">
      <h3 class="text-sm font-medium mb-2">Stack configuration</h3>
      <p class="text-xs text-zinc-500 mb-3">Your domain, server IP, and project repos will be saved as <code class="text-zinc-300">stack.json</code> in your fork.</p>
      <div id="config-status" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <code class="text-sm font-mono text-emerald-400">stack.json</code>
          <span id="config-status-badge" class="text-xs text-zinc-600">&mdash;</span>
        </div>
      </div>
    </div>

    <!-- Secrets (credentials only) -->
    <h3 class="text-sm font-medium mb-3">Secrets (credentials only)</h3>
    <div class="space-y-3" id="secrets-list">
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <code class="text-sm font-mono text-emerald-400">VPS_SSH_KEY</code>
          <span id="status-ssh" class="text-xs text-zinc-600">&mdash;</span>
        </div>
        <p class="text-xs text-zinc-500 mt-0.5">SSH private key from step 1</p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <code class="text-sm font-mono text-emerald-400">CLOUDFLARE_API_TOKEN</code>
          <span id="status-cf" class="text-xs text-zinc-600">&mdash;</span>
        </div>
        <p class="text-xs text-zinc-500 mt-0.5">Cloudflare API token for DNS &amp; SSL</p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <code class="text-sm font-mono text-emerald-400">KON_GITHUB_TOKEN</code>
          <span id="status-gh" class="text-xs text-zinc-600">&mdash;</span>
        </div>
        <p class="text-xs text-zinc-500 mt-0.5">GitHub PAT for workflow access</p>
      </div>

      <!-- Optional AI secrets -->
      <div id="ai-secrets" class="hidden space-y-3">
        <p class="text-xs text-zinc-500 mt-2 mb-1">AI tools (from step 5)</p>

        <div id="secret-anthropic" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 hidden">
          <div class="flex items-center justify-between">
            <code class="text-sm font-mono text-emerald-400">ANTHROPIC_API_KEY</code>
            <span id="status-anthropic" class="text-xs text-zinc-600">&mdash;</span>
          </div>
        </div>

        <div id="secret-openai" class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 hidden">
          <div class="flex items-center justify-between">
            <code class="text-sm font-mono text-emerald-400">OPENAI_API_KEY</code>
            <span id="status-openai" class="text-xs text-zinc-600">&mdash;</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <button id="set-all-btn" type="button"
        class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-800 disabled:text-zinc-600 disabled:cursor-not-allowed text-sm font-medium rounded-lg transition-colors">
        Save config &amp; set secrets
      </button>
    </div>

    <div id="result-msg" class="mt-4 hidden"></div>
  </div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var token = state.githubPat || '';
  var btn = document.getElementById('next-btn');
  var forkBtn = document.getElementById('fork-btn');
  var forkBadge = document.getElementById('fork-status-badge');
  var forkDetail = document.getElementById('fork-status-detail');
  var configSection = document.getElementById('config-section');
  var configBadge = document.getElementById('config-status-badge');
  var setAllBtn = document.getElementById('set-all-btn');
  var msgEl = document.getElementById('result-msg');

  var konFork = state.konForkFullName || '';

  function ghApi(method, path, body) {
    var opts = {
      method: method,
      headers: { Authorization: 'token ' + token, 'Content-Type': 'application/json' },
    };
    if (body) opts.body = JSON.stringify(body);
    return fetch('https://api.github.com' + path, opts);
  }

  // ── Build stack.json content ──────────────────────────────────────────
  function buildStackJson() {
    var repos = state.repos || [];
    return JSON.stringify({
      domain: state.domain || 'example.com',
      vps_host: state.ipv4 || '0.0.0.0',
      github_user: '', // will be filled after we know the user
      repos_dir: 'repos',
      ports_per_session: 10,
      port_range_start: 4000,
      port_range_end: 9000,
      repos: repos.map(function(r) {
        return { name: r.name, url: r.url, submodules: r.submodules || false, services: r.services || [] };
      })
    }, null, 2);
  }

  // ── Fork detection ────────────────────────────────────────────────────
  function checkFork() {
    if (!token) {
      forkBadge.textContent = 'no token';
      forkDetail.textContent = 'Go back to step 4 to set your GitHub token.';
      return;
    }

    if (konFork) {
      ghApi('GET', '/repos/' + konFork).then(function(r) {
        if (r.ok) { showForkReady(konFork); }
        else { konFork = ''; GS.set({ konForkFullName: '' }); detectFork(); }
      });
      return;
    }
    detectFork();
  }

  function detectFork() {
    forkBadge.textContent = 'checking...';
    forkDetail.textContent = 'Looking for an existing fork of catFurr/kon...';

    ghApi('GET', '/repos/catFurr/kon/forks?per_page=100').then(function(r) {
      if (!r.ok) throw new Error('Cannot check forks');
      return r.json();
    }).then(function(forks) {
      return ghApi('GET', '/user').then(function(r) { return r.json(); }).then(function(user) {
        var myFork = forks.find(function(f) { return f.owner.login === user.login; });
        if (myFork) {
          konFork = myFork.full_name;
          GS.set({ konForkFullName: konFork });
          showForkReady(konFork);
        } else {
          forkBadge.textContent = 'not found';
          forkBadge.className = 'text-xs text-yellow-400';
          forkDetail.textContent = 'No fork found. Click below to create one.';
          forkBtn.classList.remove('hidden');
        }
      });
    }).catch(function(e) {
      forkBadge.textContent = 'error';
      forkBadge.className = 'text-xs text-red-400';
      forkDetail.textContent = 'Error: ' + e.message;
      forkBtn.classList.remove('hidden');
      forkBtn.textContent = 'Try forking anyway';
    });
  }

  function showForkReady(forkName) {
    forkBadge.textContent = '\u2713 ready';
    forkBadge.className = 'text-xs text-emerald-400';
    forkDetail.innerHTML = 'Using <a href="https://github.com/' + forkName + '" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">' + forkName + '</a>';
    forkBtn.classList.add('hidden');
    configSection.classList.remove('hidden');
  }

  forkBtn.addEventListener('click', function() {
    forkBtn.disabled = true;
    forkBtn.textContent = 'Forking...';
    forkBadge.textContent = 'forking...';

    ghApi('POST', '/repos/catFurr/kon/forks', {}).then(function(r) {
      if (!r.ok && r.status !== 202) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function(fork) {
      konFork = fork.full_name;
      GS.set({ konForkFullName: konFork });
      showForkReady(konFork);
    }).catch(function(e) {
      forkBadge.textContent = 'failed';
      forkBadge.className = 'text-xs text-red-400';
      forkDetail.textContent = 'Fork failed: ' + e.message;
      forkBtn.disabled = false;
      forkBtn.textContent = 'Retry fork';
    });
  });

  // ── Secrets ───────────────────────────────────────────────────────────
  var secrets = [
    { name: 'VPS_SSH_KEY',          value: state.sshKeyContent || '',   statusId: 'status-ssh',   required: true },
    { name: 'CLOUDFLARE_API_TOKEN', value: state.cloudflareToken || '', statusId: 'status-cf',    required: true },
    { name: 'KON_GITHUB_TOKEN',     value: token,                      statusId: 'status-gh',    required: true },
  ];

  if (state.anthropicApiKey || state.openaiApiKey) {
    document.getElementById('ai-secrets').classList.remove('hidden');
  }
  if (state.anthropicApiKey) {
    document.getElementById('secret-anthropic').classList.remove('hidden');
    secrets.push({ name: 'ANTHROPIC_API_KEY', value: state.anthropicApiKey, statusId: 'status-anthropic', required: false });
  }
  if (state.openaiApiKey) {
    document.getElementById('secret-openai').classList.remove('hidden');
    secrets.push({ name: 'OPENAI_API_KEY', value: state.openaiApiKey, statusId: 'status-openai', required: false });
  }

  function setStatus(id, ok, text) {
    var el = document.getElementById(id);
    el.textContent = text;
    el.className = 'text-xs ' + (ok ? 'text-emerald-400' : ok === false ? 'text-red-400' : 'text-zinc-600');
  }

  async function encryptSecret(publicKey, secretValue) {
    await sodium.ready;
    var key = sodium.from_base64(publicKey, sodium.base64_variants.ORIGINAL);
    var msgBytes = new TextEncoder().encode(secretValue);
    var encrypted = sodium.crypto_box_seal(msgBytes, key);
    return sodium.to_base64(encrypted, sodium.base64_variants.ORIGINAL);
  }

  async function setSecret(repo, secretName, secretValue, publicKey, keyId) {
    var encryptedValue = await encryptSecret(publicKey, secretValue);
    var r = await fetch('https://api.github.com/repos/' + repo + '/actions/secrets/' + secretName, {
      method: 'PUT',
      headers: { Authorization: 'token ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ encrypted_value: encryptedValue, key_id: keyId }),
    });
    if (!r.ok) {
      var body = '';
      try { body = (await r.json()).message; } catch(e) {}
      throw new Error('HTTP ' + r.status + (body ? ' \u2014 ' + body : ''));
    }
  }

  // ── Commit stack.json ─────────────────────────────────────────────────
  async function commitStackJson() {
    // Get github username for the config
    var userRes = await ghApi('GET', '/user');
    var userData = await userRes.json();
    var githubUser = userData.login || '';

    var stackObj = JSON.parse(buildStackJson());
    stackObj.github_user = githubUser;
    var content = JSON.stringify(stackObj, null, 2);
    var b64Content = btoa(unescape(encodeURIComponent(content)));

    // Check if file exists (need SHA for update)
    var existRes = await ghApi('GET', '/repos/' + konFork + '/contents/stack.json');
    var body = { message: 'Update stack configuration', content: b64Content };
    if (existRes.ok) {
      var existData = await existRes.json();
      body.sha = existData.sha;
    }

    var putRes = await ghApi('PUT', '/repos/' + konFork + '/contents/stack.json', body);
    if (!putRes.ok) throw new Error('Failed to commit stack.json');
  }

  // ── Save all button ───────────────────────────────────────────────────
  setAllBtn.addEventListener('click', async function() {
    if (!token || !konFork) return;

    setAllBtn.disabled = true;
    setAllBtn.textContent = 'Saving...';
    msgEl.classList.add('hidden');

    var allOk = true;
    var failed = [];

    try {
      // 1. Commit stack.json
      configBadge.textContent = 'committing...';
      configBadge.className = 'text-xs text-zinc-600';
      try {
        await commitStackJson();
        configBadge.textContent = '\u2713 committed';
        configBadge.className = 'text-xs text-emerald-400';
      } catch (e) {
        configBadge.textContent = '\u2717 failed';
        configBadge.className = 'text-xs text-red-400';
        failed.push({ name: 'stack.json', error: e.message });
        allOk = false;
      }

      // 2. Set secrets
      var keyRes = await ghApi('GET', '/repos/' + konFork + '/actions/secrets/public-key');
      if (!keyRes.ok) throw new Error('Failed to get repo public key');
      var keyData = await keyRes.json();

      for (var i = 0; i < secrets.length; i++) {
        var s = secrets[i];
        setStatus(s.statusId, null, 'setting...');
        try {
          await setSecret(konFork, s.name, s.value, keyData.key, keyData.key_id);
          setStatus(s.statusId, true, '\u2713 set');
        } catch (e) {
          setStatus(s.statusId, false, '\u2717 failed');
          failed.push({ name: s.name, error: e.message });
          allOk = false;
        }
      }

      msgEl.classList.remove('hidden');
      if (allOk) {
        msgEl.innerHTML = '<p class="text-sm text-emerald-400">\u2713 Config saved and secrets set on ' + konFork + '.</p>';
        btn.disabled = false;
      } else {
        msgEl.innerHTML =
          '<div class="bg-red-950/30 border border-red-900/50 rounded-lg p-4 space-y-2">' +
            '<p class="text-sm text-red-400 font-medium">Some items failed</p>' +
            '<ul class="text-xs text-zinc-400 space-y-1 mt-1">' +
            failed.map(function(f) { return '<li>&bull; <code class="text-zinc-300">' + f.name + '</code> \u2014 ' + f.error + '</li>'; }).join('') +
            '</ul>' +
          '</div>';
      }
    } catch (e) {
      msgEl.classList.remove('hidden');
      msgEl.innerHTML = '<p class="text-sm text-red-400">Error: ' + e.message + '</p>';
    } finally {
      setAllBtn.disabled = false;
      setAllBtn.textContent = 'Save config & set secrets';
    }
  });

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });

  checkFork();
})();
</script>
