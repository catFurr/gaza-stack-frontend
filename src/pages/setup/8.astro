---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={8} title="Set GitHub secrets" subtitle="We'll automatically configure the secrets your repo needs for deployments.">
  <script src="https://cdn.jsdelivr.net/npm/libsodium-wrappers@0.7.15/dist/modules/libsodium-wrappers.min.js"></script>

  <div class="space-y-3" id="secrets-list">
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <code class="text-sm font-mono text-emerald-400">VPS_SSH_KEY</code>
        <span id="status-ssh" class="text-xs text-zinc-600">&mdash;</span>
      </div>
      <p class="text-xs text-zinc-500 mt-0.5">SSH private key from step 1</p>
      <p class="text-xs text-zinc-400 font-mono mt-1" id="val-ssh"></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <code class="text-sm font-mono text-emerald-400">VPS_HOST</code>
        <span id="status-host" class="text-xs text-zinc-600">&mdash;</span>
      </div>
      <p class="text-xs text-zinc-500 mt-0.5">Server IPv4 address</p>
      <p class="text-xs text-zinc-400 font-mono mt-1" id="val-host"></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <code class="text-sm font-mono text-emerald-400">CLOUDFLARE_API_TOKEN</code>
        <span id="status-cf" class="text-xs text-zinc-600">&mdash;</span>
      </div>
      <p class="text-xs text-zinc-500 mt-0.5">Cloudflare API token for DNS &amp; SSL</p>
      <p class="text-xs text-zinc-400 font-mono mt-1" id="val-cf"></p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <code class="text-sm font-mono text-emerald-400">KON_GITHUB_TOKEN</code>
        <span id="status-gh" class="text-xs text-zinc-600">&mdash;</span>
      </div>
      <p class="text-xs text-zinc-500 mt-0.5">GitHub PAT for workflow access</p>
      <p class="text-xs text-zinc-400 font-mono mt-1" id="val-gh"></p>
    </div>
  </div>

  <div id="missing-msg" class="mt-4 hidden">
    <p class="text-sm text-red-400">Some values are missing. Go back to previous steps to fill them in.</p>
  </div>

  <div class="mt-6">
    <button id="set-secrets-btn"
      class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 disabled:bg-zinc-800 disabled:text-zinc-600 disabled:cursor-not-allowed text-sm font-medium rounded-lg transition-colors">
      Set all secrets
    </button>
  </div>

  <div id="secrets-msg" class="mt-4 hidden"></div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var repo = state.repoFullName || '';
  var token = state.githubPat || '';
  var btn = document.getElementById('next-btn');
  var setBtn = document.getElementById('set-secrets-btn');
  var msgEl = document.getElementById('secrets-msg');

  var secrets = [
    { name: 'VPS_SSH_KEY',          value: state.sshKeyContent || '',    statusId: 'status-ssh',  valId: 'val-ssh' },
    { name: 'VPS_HOST',             value: state.ipv4 || '',             statusId: 'status-host', valId: 'val-host' },
    { name: 'CLOUDFLARE_API_TOKEN', value: state.cloudflareToken || '',  statusId: 'status-cf',   valId: 'val-cf' },
    { name: 'KON_GITHUB_TOKEN',     value: token,                       statusId: 'status-gh',   valId: 'val-gh' },
  ];

  // Show values (masked for sensitive ones)
  var allPresent = true;
  secrets.forEach(function(s) {
    var display;
    if (!s.value) {
      display = '(not set)';
      allPresent = false;
    } else if (s.name === 'VPS_HOST') {
      display = s.value;
    } else if (s.name === 'VPS_SSH_KEY') {
      display = s.value.split('\n')[0].slice(0, 30) + '...';
    } else {
      display = s.value.slice(0, 8) + '...' + s.value.slice(-4);
    }
    document.getElementById(s.valId).textContent = display;
  });

  if (!allPresent) {
    document.getElementById('missing-msg').classList.remove('hidden');
    setBtn.disabled = true;
  }

  function setStatus(id, ok, text) {
    var el = document.getElementById(id);
    el.textContent = text;
    el.className = 'text-xs ' + (ok ? 'text-emerald-400' : ok === false ? 'text-red-400' : 'text-zinc-600');
  }

  async function encryptSecret(publicKey, secretValue) {
    await sodium.ready;
    var key = sodium.from_base64(publicKey, sodium.base64_variants.ORIGINAL);
    var msgBytes = new TextEncoder().encode(secretValue);
    var encrypted = sodium.crypto_box_seal(msgBytes, key);
    return sodium.to_base64(encrypted, sodium.base64_variants.ORIGINAL);
  }

  async function setSecret(secretName, secretValue, publicKey, keyId) {
    var encryptedValue = await encryptSecret(publicKey, secretValue);
    var r = await fetch('https://api.github.com/repos/' + repo + '/actions/secrets/' + secretName, {
      method: 'PUT',
      headers: {
        Authorization: 'token ' + token,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ encrypted_value: encryptedValue, key_id: keyId }),
    });
    if (!r.ok) throw new Error('HTTP ' + r.status);
  }

  setBtn.addEventListener('click', async function() {
    if (!token || !repo) return;

    setBtn.disabled = true;
    setBtn.textContent = 'Setting secrets...';
    msgEl.classList.add('hidden');

    try {
      var keyRes = await fetch('https://api.github.com/repos/' + repo + '/actions/secrets/public-key', {
        headers: { Authorization: 'token ' + token }
      });
      if (!keyRes.ok) throw new Error('Failed to get repo public key (HTTP ' + keyRes.status + ')');
      var keyData = await keyRes.json();

      var allOk = true;
      for (var i = 0; i < secrets.length; i++) {
        var s = secrets[i];
        setStatus(s.statusId, null, 'setting...');
        try {
          await setSecret(s.name, s.value, keyData.key, keyData.key_id);
          setStatus(s.statusId, true, '\u2713 set');
        } catch (e) {
          setStatus(s.statusId, false, '\u2717 failed');
          allOk = false;
        }
      }

      if (allOk) {
        msgEl.classList.remove('hidden');
        msgEl.innerHTML = '<p class="text-sm text-emerald-400">All secrets configured successfully.</p>';
        btn.disabled = false;
      } else {
        msgEl.classList.remove('hidden');
        msgEl.innerHTML = '<p class="text-sm text-red-400">Some secrets failed. Check your PAT has repo scope and try again.</p>';
      }
    } catch (e) {
      msgEl.classList.remove('hidden');
      msgEl.innerHTML = '<p class="text-sm text-red-400">Error: ' + e.message + '</p>';
    } finally {
      setBtn.disabled = false;
      setBtn.textContent = 'Set all secrets';
    }
  });

  btn.addEventListener('click', function() {
    window.location.href = btn.dataset.href;
  });
})();
</script>
