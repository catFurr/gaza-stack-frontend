---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={7} title="Describe your infra" subtitle="Select the repository you want to deploy. Static sites only for now.">
  <div class="space-y-4">
    <div>
      <label for="repo-select" class="block text-sm font-medium mb-1.5">Repository</label>
      <select id="repo-select"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 appearance-none cursor-pointer">
        <option value="">Loading repositories...</option>
      </select>
    </div>

    <div>
      <label for="build-cmd" class="block text-sm font-medium mb-1.5">Build command</label>
      <input id="build-cmd" type="text" placeholder="bun run build"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
    </div>

    <div>
      <label for="out-dir" class="block text-sm font-medium mb-1.5">Output directory</label>
      <input id="out-dir" type="text" placeholder="dist"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
    </div>

    <div>
      <label for="branch" class="block text-sm font-medium mb-1.5">Default branch</label>
      <input id="branch" type="text" placeholder="main"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
    </div>
  </div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var select = document.getElementById('repo-select');
  var buildCmd = document.getElementById('build-cmd');
  var outDir = document.getElementById('out-dir');
  var branch = document.getElementById('branch');
  var btn = document.getElementById('next-btn');

  buildCmd.value = GS.val('buildCommand') || 'bun run build';
  outDir.value = GS.val('outputDir') || 'dist';
  branch.value = GS.val('defaultBranch') || 'main';

  function validate() {
    btn.disabled = !(select.value && buildCmd.value.trim() && outDir.value.trim() && branch.value.trim());
  }

  // Fetch repos from GitHub
  var token = state.githubPat;
  if (!token) {
    select.innerHTML = '<option value="">No GitHub token \u2014 go back to step 4</option>';
  } else {
    fetch('https://api.github.com/user/repos?per_page=100&sort=updated&affiliation=owner', {
      headers: { Authorization: 'token ' + token }
    })
    .then(function(r) { return r.json(); })
    .then(function(repos) {
      select.innerHTML = '<option value="">Select a repository</option>';
      repos.forEach(function(repo) {
        var opt = document.createElement('option');
        opt.value = repo.full_name;
        opt.textContent = repo.full_name;
        if (repo.full_name === GS.val('repoFullName')) opt.selected = true;
        select.appendChild(opt);
      });
      validate();
    })
    .catch(function() {
      select.innerHTML = '<option value="">Failed to load repos</option>';
    });
  }

  select.addEventListener('change', validate);
  buildCmd.addEventListener('input', validate);
  outDir.addEventListener('input', validate);
  branch.addEventListener('input', validate);
  validate();

  btn.addEventListener('click', function() {
    GS.set({
      repoFullName: select.value,
      buildCommand: buildCmd.value.trim(),
      outputDir: outDir.value.trim(),
      defaultBranch: branch.value.trim(),
    });
    window.location.href = btn.dataset.href;
  });
})();
</script>
