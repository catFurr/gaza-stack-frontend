---
import SetupLayout from '../../layouts/SetupLayout.astro';
---
<SetupLayout step={7} title="Select your project" subtitle="Choose the repository you'll work on in dev sessions.">
  <div class="space-y-4">
    <div>
      <label for="repo-select" class="block text-sm font-medium mb-1.5">Repository</label>
      <select id="repo-select"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 appearance-none cursor-pointer">
        <option value="">Loading repositories...</option>
      </select>
    </div>

    <div>
      <label for="dev-cmd" class="block text-sm font-medium mb-1.5">Dev command <span class="text-zinc-500 font-normal">(optional)</span></label>
      <input id="dev-cmd" type="text" placeholder="npm run dev"
        class="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500/50 placeholder-zinc-600 font-mono" />
      <p class="text-xs text-zinc-500 mt-1.5">Auto-detected from package.json if left empty</p>
    </div>
  </div>
</SetupLayout>

<script is:inline>
(function() {
  var state = GS.get();
  var select = document.getElementById('repo-select');
  var devCmd = document.getElementById('dev-cmd');
  var btn = document.getElementById('next-btn');

  devCmd.value = GS.val('devCommand') || '';

  function validate() {
    btn.disabled = !select.value;
  }

  var token = state.githubPat;
  if (!token) {
    select.innerHTML = '<option value="">No GitHub token \u2014 go back to step 4</option>';
  } else {
    fetch('https://api.github.com/user/repos?per_page=100&sort=updated&affiliation=owner', {
      headers: { Authorization: 'token ' + token }
    })
    .then(function(r) { return r.json(); })
    .then(function(repos) {
      select.innerHTML = '<option value="">Select a repository</option>';
      repos.forEach(function(repo) {
        var opt = document.createElement('option');
        opt.value = repo.full_name;
        opt.textContent = repo.full_name;
        if (repo.full_name === GS.val('repoFullName')) opt.selected = true;
        select.appendChild(opt);
      });
      validate();
    })
    .catch(function() {
      select.innerHTML = '<option value="">Failed to load repos</option>';
    });
  }

  select.addEventListener('change', validate);
  validate();

  btn.addEventListener('click', function() {
    GS.set({
      repoFullName: select.value,
      devCommand: devCmd.value.trim(),
    });
    window.location.href = btn.dataset.href;
  });
})();
</script>
