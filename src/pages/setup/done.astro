---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Setup Complete">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-md w-full text-center">
      <p class="text-4xl mb-4">&#127881;</p>
      <h1 class="text-2xl font-bold tracking-tight mb-2">Done</h1>
      <p class="text-zinc-400 text-sm mb-8">Your stack is live.</p>

      <div class="text-sm text-left bg-zinc-900 border border-zinc-800 rounded-lg p-5 font-mono space-y-3">
        <div>Visit <a id="live-url" href="#" target="_blank" class="text-emerald-400 hover:text-emerald-300 transition-colors">mysite.com</a></div>
        <div>Run <code class="text-emerald-400">ssh <span id="ssh-alias">mysite</span></code> to start sessions</div>
        <div>Use <code class="text-emerald-400">kon --help</code> on the server for guides</div>
      </div>

      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/" class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">Home</a>
        <button id="reset-btn" class="text-sm text-zinc-600 hover:text-zinc-400 transition-colors">Reset setup data</button>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
(function() {
  var state = JSON.parse(localStorage.getItem('gs_setup') || '{}');
  var domain = state.domain || 'mysite.com';
  var alias = domain.split('.')[0];

  var liveUrl = document.getElementById('live-url');
  liveUrl.href = 'https://' + domain;
  liveUrl.textContent = domain;

  document.getElementById('ssh-alias').textContent = alias;

  document.getElementById('reset-btn').addEventListener('click', function() {
    if (confirm('Clear all setup data from this browser?')) {
      localStorage.removeItem('gs_setup');
      window.location.href = '/';
    }
  });
})();
</script>
